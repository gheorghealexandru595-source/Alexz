[
 {
  "i": 0,
  "s": 0,
  "e": 0.82,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 0.82,
  "e": 2.11,
  "line": "every happy birthday you get"
 },
 {
  "i": 2,
  "s": 2.11,
