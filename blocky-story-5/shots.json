[
 {
  "i": 0,
  "s": 0,
  "e": 0.85,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 0.85,
  "e": 1.71,
  "line": "every lie you tell"
 },
 {
  "i": 2,
  "s": 1.71,
  "e": 2.52,
  "line": "makes you shrink."
 },
 {
  "i": 3,
  "s": 2.52,
  "e": 3.46,
  "line": "That's why honest people"
 },
 {
  "i": 4,
  "s": 3.46,
  "e": 4.54,
  "line": "duck under doorframes,"
 },
 {
  "i": 5,
  "s": 4.54,
  "e": 5.81,
  "line": "and liars get stepped on."
 },
 {
  "i": 6,
  "s": 5.81,
  "e": 6.64,
  "line": "I was about average."
 },
 {
  "i": 7,
  "s": 6.64,
  "e": 7.78,
  "line": "But my best friend Sam"
 },
 {
  "i": 8,
  "s": 7.78,
  "e": 9.2,
  "line": "was the size of a water bottle."
 },
 {
  "i": 9,
  "s": 9.2,
  "e": 11.32,
  "line": "He needed a stool to reach the water fountain."
 },
 {
  "i": 10,
  "s": 11.32,
  "e": 13.02,
  "line": "Meanwhile, Nora never lied."
 },
 {
  "i": 11,
  "s": 13.02,
  "e": 14.68,
  "line": "Ugly sweater? She said so."
 },
 {
  "i": 12,
  "s": 14.68,
  "e": 16.26,
  "line": "Burnt cookies? She said so."
 },
 {
  "i": 13,
  "s": 16.26,
  "e": 17.96,
  "line": "Bad singing? Also said so."
 },
 {
  "i": 14,
  "s": 17.96,
  "e": 20.26,
  "line": "Then our teacher asked who drew on the board."
 },
 {
  "i": 15,
  "s": 20.26,
  "e": 21.55,
  "line": "I said, not me."
 },
 {
  "i": 16,
  "s": 21.55,
  "e": 22.73,
  "line": "I shrank two inches."
 },
 {
  "i": 17,
  "s": 22.73,
  "e": 24.01,
  "line": "Nora raised an eyebrow."
 },
 {
  "i": 18,
  "s": 24.01,
  "e": 25.48,
  "line": "And that's when I had an idea."
 },
 {
  "i": 19,
  "s": 25.48,
  "e": 26.65,
  "line": "If I only told the truth,"
 },
 {
  "i": 20,
  "s": 26.65,
  "e": 27.8,
  "line": "I'd be tall like Nora."
 },
 {
  "i": 21,
  "s": 27.8,
  "e": 29.27,
  "line": "The sky is blue. Nothing."
 },
 {
  "i": 22,
  "s": 29.27,
  "e": 30.02,
  "line": "Water is wet."
 },
 {
  "i": 23,
  "s": 30.02,
  "e": 30.78,
  "line": "Still nothing."
 },
 {
  "i": 24,
  "s": 30.78,
  "e": 32.4,
  "line": "Then I told the teacher it was me."
 },
 {
  "i": 25,
  "s": 32.4,
  "e": 33.35,
  "line": "I grew right back."
 },
 {
  "i": 26,
  "s": 33.35,
  "e": 35.09,
  "line": "So I told the truth all day."
 },
 {
  "i": 27,
  "s": 35.09,
  "e": 36.04,
  "line": "I hate broccoli."
 },
 {
  "i": 28,
  "s": 36.04,
  "e": 37.03,
  "line": "I'm scared of ducks."
 },
 {
  "i": 29,
  "s": 37.03,
  "e": 38.27,
  "line": "I sleep with a teddy bear."
 },
 {
  "i": 30,
  "s": 38.27,
  "e": 40.39,
  "line": "By lunch, I was almost as tall as Nora."
 },
 {
  "i": 31,
  "s": 40.39,
  "e": 41.6,
  "line": "But then I saw Sam,"
 },
 {
  "i": 32,
  "s": 41.6,
  "e": 43.18,
  "line": "sitting in a lunchbox, alone."
 },
 {
  "i": 33,
  "s": 43.18,
  "e": 44.27,
  "line": "I'd spent all day growing"
 },
 {
  "i": 34,
  "s": 44.27,
  "e": 45.8,
  "line": "while my best friend kept shrinking."
 },
 {
  "i": 35,
  "s": 45.8,
  "e": 47.21,
  "line": "So I asked, why do you lie?"
 },
 {
  "i": 36,
  "s": 47.21,
  "e": 48.18,
  "line": "So people like me."
 },
 {
  "i": 37,
  "s": 48.18,
  "e": 49.06,
  "line": "I like the real you."
 },
 {
  "i": 38,
  "s": 49.06,
  "e": 50.07,
  "line": "He took a deep breath."
 },
 {
  "i": 39,
  "s": 50.07,
  "e": 51.05,
  "line": "I hate my haircut."
 },
 {
  "i": 40,
  "s": 51.05,
  "e": 51.98,
  "line": "And I can't swim."
 },
 {
  "i": 41,
  "s": 51.98,
  "e": 54.95,
  "line": "For the first time, Sam drank from the fountain by himself."
 },
 {
  "i": 42,
  "s": 54.95,
  "e": 56.83,
  "line": "Then he said, I drew on the board too."
 },
 {
  "i": 43,
  "s": 56.83,
  "e": 57.68,
  "line": "I stared at him."
 },
 {
  "i": 44,
  "s": 57.68,
  "e": 59.589,
  "line": "So we told the teacher. Together."
 }
]