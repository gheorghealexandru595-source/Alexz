[
 {
  "i": 0,
  "s": 0,
  "e": 0.88,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 0.88,
  "e": 1.78,
  "line": "every friend you make"
 },
 {
  "i": 2,
  "s": 1.78,
  "e": 3.26,
  "line": "lights a lantern above your head."
 },
 {
  "i": 3,
  "s": 3.26,
  "e": 5.55,
  "line": "That's why popular kids glow like birthday cakes,"
 },
 {
  "i": 4,
  "s": 5.55,
  "e": 6.64,
  "line": "and lonely kids"
 },
 {
  "i": 5,
  "s": 6.64,
  "e": 7.67,
  "line": "walk home in the dark."
 },
 {
  "i": 6,
  "s": 7.67,
  "e": 8.99,
  "line": "I had about three lanterns."
 },
 {
  "i": 7,
  "s": 8.99,
  "e": 10.15,
  "line": "But my best friend Finn"
 },
 {
  "i": 8,
  "s": 10.15,
  "e": 11.29,
  "line": "didn't have a single one."
 },
 {
  "i": 9,
  "s": 11.29,
  "e": 13.16,
  "line": "His was the only dark house on the street."
 },
 {
  "i": 10,
  "s": 13.16,
  "e": 14.48,
  "line": "He'd never had a birthday party,"
 },
 {
  "i": 11,
  "s": 14.48,
  "e": 16,
  "line": "because nobody could find his house."
 },
 {
  "i": 12,
  "s": 16,
  "e": 18.3,
  "line": "Meanwhile, Coco had ninety-nine lanterns."
 },
 {
  "i": 13,
  "s": 18.3,
  "e": 19.56,
  "line": "She lit up the whole block."
 },
 {
  "i": 14,
  "s": 19.56,
  "e": 20.95,
  "line": "Moths followed her home."
 },
 {
  "i": 15,
  "s": 20.95,
  "e": 22.11,
  "line": "Planes waved at her."
 },
 {
  "i": 16,
  "s": 22.11,
  "e": 23.48,
  "line": "Then Jake fell off his bike,"
 },
 {
  "i": 17,
  "s": 23.48,
  "e": 24.43,
  "line": "and I laughed at him."
 },
 {
  "i": 18,
  "s": 24.43,
  "e": 26.34,
  "line": "Pop. One of my lanterns went out."
 },
 {
  "i": 19,
  "s": 26.34,
  "e": 27.59,
  "line": "Jake didn't even look at me."
 },
 {
  "i": 20,
  "s": 27.59,
  "e": 28.85,
  "line": "And that's when I had an idea."
 },
 {
  "i": 21,
  "s": 28.85,
  "e": 30.09,
  "line": "If I made a hundred friends,"
 },
 {
  "i": 22,
  "s": 30.09,
  "e": 30.91,
  "line": "I'd beat Coco."
 },
 {
  "i": 23,
  "s": 30.91,
  "e": 32.6,
  "line": "I handed out flyers. Nothing."
 },
 {
  "i": 24,
  "s": 32.6,
  "e": 33.76,
  "line": "I offered free candy."
 },
 {
  "i": 25,
  "s": 33.76,
  "e": 34.49,
  "line": "Still nothing."
 },
 {
  "i": 26,
  "s": 34.49,
  "e": 36.5,
  "line": "Then I helped a new kid find his classroom."
 },
 {
  "i": 27,
  "s": 36.5,
  "e": 37.62,
  "line": "We talked all through lunch."
 },
 {
  "i": 28,
  "s": 37.62,
  "e": 39.09,
  "line": "Ding. A new lantern lit up."
 },
 {
  "i": 29,
  "s": 39.09,
  "e": 40.66,
  "line": "So I made friends everywhere."
 },
 {
  "i": 30,
  "s": 40.66,
  "e": 41.44,
  "line": "The chess club."
 },
 {
  "i": 31,
  "s": 41.44,
  "e": 42.14,
  "line": "The skaters."
 },
 {
  "i": 32,
  "s": 42.14,
  "e": 42.94,
  "line": "The lunch lady."
 },
 {
  "i": 33,
  "s": 42.94,
  "e": 45.2,
  "line": "By the weekend, I had twenty lanterns."
 },
 {
  "i": 34,
  "s": 45.2,
  "e": 46.9,
  "line": "But then I walked past Finn's house."
 },
 {
  "i": 35,
  "s": 46.9,
  "e": 48.25,
  "line": "It was still completely dark."
 },
 {
  "i": 36,
  "s": 48.25,
  "e": 50.27,
  "line": "Finn was sitting on his steps, alone."
 },
 {
  "i": 37,
  "s": 50.27,
  "e": 52.02,
  "line": "I'd spent all week collecting friends"
 },
 {
  "i": 38,
  "s": 52.02,
  "e": 53.4,
  "line": "while forgetting my oldest one."
 },
 {
  "i": 39,
  "s": 53.4,
  "e": 55.12,
  "line": "So I knocked on his door with a party hat."
 },
 {
  "i": 40,
  "s": 55.12,
  "e": 56.3,
  "line": "He asked, what's this?"
 },
 {
  "i": 41,
  "s": 56.3,
  "e": 57.98,
  "line": "Your birthday party. You never had one."
 },
 {
  "i": 42,
  "s": 57.98,
  "e": 59.17,
  "line": "Then I invited everyone."
 },
 {
  "i": 43,
  "s": 59.17,
  "e": 60.42,
  "line": "One by one, they showed up."
 },
 {
  "i": 44,
  "s": 60.42,
  "e": 62.31,
  "line": "And one by one, his lanterns lit up."
 },
 {
  "i": 45,
  "s": 62.31,
  "e": 65.14,
  "line": "By midnight, Finn's house was the brightest on the street."
 },
 {
  "i": 46,
  "s": 65.14,
  "e": 66.08,
  "line": "Even Coco came."
 },
 {
  "i": 47,
  "s": 66.08,
  "e": 68.33,
  "line": "She squinted and said, I need sunglasses."
 },
 {
  "i": 48,
  "s": 68.33,
  "e": 69.604,
  "line": "Best party in town."
 }
]