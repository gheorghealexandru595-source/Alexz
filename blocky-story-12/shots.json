[
 {
  "i": 0,
  "s": 0,
  "e": 0.75,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 0.75,
  "e": 2.09,
  "line": "every smile you give someone"
 },
 {
  "i": 2,
  "s": 2.09,
  "e": 3.13,
  "line": "makes you a little lighter."
 },
 {
  "i": 3,
  "s": 3.13,
  "e": 4.46,
  "line": "Give enough, and you float."
 },
 {
  "i": 4,
  "s": 4.46,
  "e": 6.64,
  "line": "That's why happy people drift over the rooftops,"
 },
 {
  "i": 5,
  "s": 6.64,
  "e": 7.66,
  "line": "and grumpy people"
 },
 {
  "i": 6,
  "s": 7.66,
  "e": 9.18,
  "line": "stomp around on the sidewalk."
 },
 {
  "i": 7,
  "s": 9.18,
  "e": 10.65,
  "line": "I hovered about knee high."
 },
 {
  "i": 8,
  "s": 10.65,
  "e": 11.73,
  "line": "But my best friend Theo"
 },
 {
  "i": 9,
  "s": 11.73,
  "e": 13.29,
  "line": "never smiled. Not once."
 },
 {
  "i": 10,
  "s": 13.29,
  "e": 15.12,
  "line": "He'd never seen the fireworks from up high."
 },
 {
  "i": 11,
  "s": 15.12,
  "e": 16.8,
  "line": "Meanwhile, Daisy smiled so much"
 },
 {
  "i": 12,
  "s": 16.8,
  "e": 18.58,
  "line": "she had to tie herself to a mailbox."
 },
 {
  "i": 13,
  "s": 18.58,
  "e": 19.75,
  "line": "She smiled at dogs."
 },
 {
  "i": 14,
  "s": 19.75,
  "e": 21.01,
  "line": "She smiled at mailmen."
 },
 {
  "i": 15,
  "s": 21.01,
  "e": 22.81,
  "line": "She smiled at her own reflection."
 },
 {
  "i": 16,
  "s": 22.81,
  "e": 24.32,
  "line": "Then the mailman waved at me,"
 },
 {
  "i": 17,
  "s": 24.32,
  "e": 25.36,
  "line": "and I smiled back."
 },
 {
  "i": 18,
  "s": 25.36,
  "e": 27.07,
  "line": "Whoosh. I floated a whole foot."
 },
 {
  "i": 19,
  "s": 27.07,
  "e": 28.45,
  "line": "And that's when I had an idea."
 },
 {
  "i": 20,
  "s": 28.45,
  "e": 29.4,
  "line": "If I smiled enough,"
 },
 {
  "i": 21,
  "s": 29.4,
  "e": 31.34,
  "line": "I'd watch the fireworks from the sky."
 },
 {
  "i": 22,
  "s": 31.34,
  "e": 32.98,
  "line": "I smiled at a mirror. Nothing."
 },
 {
  "i": 23,
  "s": 32.98,
  "e": 34.83,
  "line": "I forced the biggest smile ever."
 },
 {
  "i": 24,
  "s": 34.83,
  "e": 36.05,
  "line": "My face just hurt."
 },
 {
  "i": 25,
  "s": 36.05,
  "e": 37.59,
  "line": "Then a little girl dropped her ice cream,"
 },
 {
  "i": 26,
  "s": 37.59,
  "e": 38.54,
  "line": "so I gave her mine."
 },
 {
  "i": 27,
  "s": 38.54,
  "e": 40.38,
  "line": "She smiled. I smiled. Whoosh."
 },
 {
  "i": 28,
  "s": 40.38,
  "e": 41.92,
  "line": "So I smiled at everyone."
 },
 {
  "i": 29,
  "s": 41.92,
  "e": 42.71,
  "line": "The whole street."
 },
 {
  "i": 30,
  "s": 42.71,
  "e": 43.55,
  "line": "The bus driver."
 },
 {
  "i": 31,
  "s": 43.55,
  "e": 44.69,
  "line": "A very confused cat."
 },
 {
  "i": 32,
  "s": 44.69,
  "e": 47.12,
  "line": "By sunset, I was floating over the rooftops."
 },
 {
  "i": 33,
  "s": 47.12,
  "e": 48.82,
  "line": "Then I looked down and saw Theo,"
 },
 {
  "i": 34,
  "s": 48.82,
  "e": 50.56,
  "line": "alone on the ground, staring up."
 },
 {
  "i": 35,
  "s": 50.56,
  "e": 52.52,
  "line": "I'd spent all day smiling at strangers"
 },
 {
  "i": 36,
  "s": 52.52,
  "e": 54.75,
  "line": "while my best friend couldn't even leave the ground."
 },
 {
  "i": 37,
  "s": 54.75,
  "e": 57.51,
  "line": "So I floated down and asked, why don't you smile?"
 },
 {
  "i": 38,
  "s": 57.51,
  "e": 58.89,
  "line": "He mumbled, my braces."
 },
 {
  "i": 39,
  "s": 58.89,
  "e": 59.76,
  "line": "Everyone laughs."
 },
 {
  "i": 40,
  "s": 59.76,
  "e": 61.84,
  "line": "So I made the goofiest face I could."
 },
 {
  "i": 41,
  "s": 61.84,
  "e": 62.46,
  "line": "He laughed."
 },
 {
  "i": 42,
  "s": 62.46,
  "e": 64.14,
  "line": "Then he smiled, braces and all."
 },
 {
  "i": 43,
  "s": 64.14,
  "e": 67.22,
  "line": "And for the first time, Theo watched the fireworks from the sky."
 },
 {
  "i": 44,
  "s": 67.22,
  "e": 69.64,
  "line": "Then he said, your goofy face is still the worst."
 },
 {
  "i": 45,
  "s": 69.64,
  "e": 70.56,
  "line": "I stared at him."
 },
 {
  "i": 46,
  "s": 70.56,
  "e": 73.04,
  "line": "Then we both smiled, and floated even higher."
 }
]