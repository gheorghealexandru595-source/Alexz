[
 {
  "i": 0,
  "s": 0,
  "e": 0.91,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 0.91,
  "e": 2.5,
  "line": "the night GTA 6 came out,"
 },
 {
  "i": 2,
  "s": 2.5,
  "e": 4.06,
  "line": "everybody stopped everything."
 },
 {
  "i": 3,
  "s": 4.06,
  "e": 5.42,
  "line": "Every window glowed blue."
 },
 {
  "i": 4,
  "s": 5.42,
  "e": 6.74,
  "line": "Every kid had a controller."
 },
 {
  "i": 5,
  "s": 6.74,
  "e": 7.75,
  "line": "Everybody except me."
 },
 {
  "i": 6,
  "s": 7.75,
  "e": 9.91,
  "line": "Because I worked the night shift at KFC."
 },
 {
  "i": 7,
  "s": 9.91,
  "e": 11.43,
  "line": "While everyone else was stealing cars,"
 },
 {
  "i": 8,
  "s": 11.43,
  "e": 13.06,
  "line": "I was stealing fries from the fryer."
 },
 {
  "i": 9,
  "s": 13.06,
  "e": 14.4,
  "line": "My best friend Marco called."
 },
 {
  "i": 10,
  "s": 14.4,
  "e": 15.74,
  "line": "Bro, you're missing everything."
 },
 {
  "i": 11,
  "s": 15.74,
  "e": 17.15,
  "line": "I said, I'm frying chicken."
 },
 {
  "i": 12,
  "s": 17.15,
  "e": 18.43,
  "line": "A kid came in for a bucket,"
 },
 {
  "i": 13,
  "s": 18.43,
  "e": 19.7,
  "line": "still holding his controller."
 },
 {
  "i": 14,
  "s": 19.7,
  "e": 21.04,
  "line": "He asked if I'd seen the map."
 },
 {
  "i": 15,
  "s": 21.04,
  "e": 22.34,
  "line": "I had not seen the map."
 },
 {
  "i": 16,
  "s": 22.34,
  "e": 23.67,
  "line": "Even my manager was playing it"
 },
 {
  "i": 17,
  "s": 23.67,
  "e": 24.57,
  "line": "behind the fryer."
 },
 {
  "i": 18,
  "s": 24.57,
  "e": 26.26,
  "line": "I fried chicken for six hours straight."
 },
 {
  "i": 19,
  "s": 26.26,
  "e": 27.8,
  "line": "And that's when the storm hit. Boom."
 },
 {
  "i": 20,
  "s": 27.8,
  "e": 28.88,
  "line": "The whole town went dark."
 },
 {
  "i": 21,
  "s": 28.88,
  "e": 30.55,
  "line": "Every TV. Every console."
 },
 {
  "i": 22,
  "s": 30.55,
  "e": 31.79,
  "line": "Every single save file."
 },
 {
  "i": 23,
  "s": 31.79,
  "e": 32.78,
  "line": "Except one building."
 },
 {
  "i": 24,
  "s": 32.78,
  "e": 34.52,
  "line": "Our fryers ran on a generator."
 },
 {
  "i": 25,
  "s": 34.52,
  "e": 35.79,
  "line": "So the whole town showed up."
 },
 {
  "i": 26,
  "s": 35.79,
  "e": 38.07,
  "line": "Hungry. Bored. Lost without their game."
 },
 {
  "i": 27,
  "s": 38.07,
  "e": 38.93,
  "line": "And for one night,"
 },
 {
  "i": 28,
  "s": 38.93,
  "e": 40.87,
  "line": "I was the most popular kid in town."
 },
 {
  "i": 29,
  "s": 40.87,
  "e": 42.45,
  "line": "I served wings to my teacher."
 },
 {
  "i": 30,
  "s": 42.45,
  "e": 43.44,
  "line": "Fries to the mayor."
 },
 {
  "i": 31,
  "s": 43.44,
  "e": 44.44,
  "line": "A bucket to Marco,"
 },
 {
  "i": 32,
  "s": 44.44,
  "e": 45.71,
  "line": "who looked kind of guilty."
 },
 {
  "i": 33,
  "s": 45.71,
  "e": 47.57,
  "line": "He said, sorry I made fun of your job."
 },
 {
  "i": 34,
  "s": 47.57,
  "e": 49.33,
  "line": "I said, sit down. I've got a break."
 },
 {
  "i": 35,
  "s": 49.33,
  "e": 50.67,
  "line": "We ate chicken by candlelight"
 },
 {
  "i": 36,
  "s": 50.67,
  "e": 52.13,
  "line": "and everyone traded stories."
 },
 {
  "i": 37,
  "s": 52.13,
  "e": 53.51,
  "line": "Somebody even brought a guitar."
 },
 {
  "i": 38,
  "s": 53.51,
  "e": 54.95,
  "line": "Nobody looked at a screen once."
 },
 {
  "i": 39,
  "s": 54.95,
  "e": 56.16,
  "line": "When the power came back,"
 },
 {
  "i": 40,
  "s": 56.16,
  "e": 57.27,
  "line": "nobody even moved."
 },
 {
  "i": 41,
  "s": 57.27,
  "e": 58.37,
  "line": "Then Marco whispered,"
 },
 {
  "i": 42,
  "s": 58.37,
  "e": 60.27,
  "line": "don't worry, I'll tell you how the game ends."
 },
 {
  "i": 43,
  "s": 60.27,
  "e": 61.57,
  "line": "I threw a drumstick at him."
 },
 {
  "i": 44,
  "s": 61.57,
  "e": 63.027,
