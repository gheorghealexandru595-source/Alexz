[
 {
  "i": 0,
  "s": 0,
  "e": 0.798,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 0.798,
  "e": 2.05,
  "line": "every picture you take"
 },
 {
  "i": 2,
  "s": 2.05,
  "e": 3.023,
  "line": "makes another you."
 },
 {
  "i": 3,
  "s": 3.023,
  "e": 4.275,
  "line": "That's why famous kids"
 },
 {
  "i": 4,
  "s": 4.275,
  "e": 6.221,
  "line": "walk around in crowds of themselves,"
 },
 {
  "i": 5,
  "s": 6.221,
  "e": 7.374,
  "line": "and camera-shy people"
 },
 {
  "i": 6,
  "s": 7.374,
  "e": 8.446,
  "line": "only ever have one."
 },
 {
  "i": 7,
  "s": 8.446,
  "e": 9.851,
  "line": "I had exactly two of me."
 },
 {
  "i": 8,
  "s": 9.851,
  "e": 11.247,
  "line": "But my best friend Benny"
 },
 {
  "i": 9,
  "s": 11.247,
  "e": 13.112,
  "line": "had never been in a single photo."
 },
 {
  "i": 10,
  "s": 13.112,
  "e": 14.634,
  "line": "Meanwhile, Jade had forty-two."
 },
 {
  "i": 11,
  "s": 14.634,
  "e": 15.85,
  "line": "One to carry her bag,"
 },
 {
  "i": 12,
  "s": 15.85,
  "e": 17.246,
  "line": "one to hold her smoothie,"
 },
 {
  "i": 13,
  "s": 17.246,
  "e": 18.462,
  "line": "and one just to clap."
 },
 {
  "i": 14,
  "s": 18.462,
  "e": 19.579,
  "line": "Then on picture day,"
 },
 {
  "i": 15,
  "s": 19.579,
  "e": 21.705,
  "line": "the photographer snapped me by accident."
 },
 {
  "i": 16,
  "s": 21.705,
  "e": 22.642,
  "line": "Pop. Three of me."
 },
 {
  "i": 17,
  "s": 22.642,
  "e": 23.471,
  "line": "Everyone gasped."
 },
 {
  "i": 18,
  "s": 23.471,
  "e": 25.201,
  "line": "And that's when I had an idea."
 },
 {
  "i": 19,
  "s": 25.201,
  "e": 26.597,
  "line": "If I got enough pictures,"
 },
 {
  "i": 20,
  "s": 26.597,
  "e": 28.047,
  "line": "I'd be a crowd like Jade."
 },
 {
  "i": 21,
  "s": 28.047,
  "e": 29.353,
  "line": "I posed by the lockers."
 },
 {
  "i": 22,
  "s": 29.353,
  "e": 30.137,
  "line": "Nobody noticed."
 },
 {
  "i": 23,
  "s": 30.137,
  "e": 31.119,
  "line": "I did a backflip."
 },
 {
  "i": 24,
  "s": 31.119,
  "e": 31.857,
  "line": "Still nothing."
 },
 {
  "i": 25,
  "s": 31.857,
  "e": 33.488,
  "line": "Then a kid dropped his books,"
 },
 {
  "i": 26,
  "s": 33.488,
  "e": 35.172,
  "line": "so I helped him pick them up,"
 },
 {
  "i": 27,
  "s": 35.172,
  "e": 36.749,
  "line": "and everyone took my picture."
 },
 {
  "i": 28,
  "s": 36.749,
  "e": 37.452,
  "line": "Pop. Pop. Pop."
 },
 {
  "i": 29,
  "s": 37.452,
  "e": 38.938,
  "line": "So I started holding doors,"
 },
 {
  "i": 30,
  "s": 38.938,
  "e": 39.722,
  "line": "carrying trays,"
 },
 {
  "i": 31,
  "s": 39.722,
  "e": 41.109,
  "line": "and cheering for everyone."
 },
 {
  "i": 32,
  "s": 41.109,
  "e": 43.154,
  "line": "By lunchtime there were twelve of me."
 },
 {
  "i": 33,
  "s": 43.154,
  "e": 44.55,
  "line": "But then I noticed Benny"
 },
 {
  "i": 34,
  "s": 44.55,
  "e": 45.243,
  "line": "eating alone."
 },
 {
  "i": 35,
  "s": 45.243,
  "e": 46.18,
  "line": "Just one of him."
 },
 {
  "i": 36,
  "s": 46.18,
  "e": 48.126,
  "line": "I'd spent all day collecting myself"
 },
 {
  "i": 37,
  "s": 48.126,
  "e": 49.612,
  "line": "and ignored my best friend."
 },
 {
  "i": 38,
  "s": 49.612,
  "e": 50.919,
  "line": "I sat down. Benny, smile."
 },
 {
  "i": 39,
  "s": 50.919,
  "e": 51.801,
  "line": "I hate pictures."
 },
 {
  "i": 40,
  "s": 51.801,
  "e": 52.315,
  "line": "Just one."
 },
 {
  "i": 41,
  "s": 52.315,
  "e": 52.963,
  "line": "Click. Click."
 },
 {
  "i": 42,
  "s": 52.963,
  "e": 54.783,
  "line": "For once, Benny had a full table."
 },
 {
  "i": 43,
  "s": 54.783,
  "e": 56.179,
  "line": "Then he grabbed my phone"
 },
 {
  "i": 44,
  "s": 56.179,
  "e": 57.621,
  "line": "and snapped me right back."
 },
 {
  "i": 45,
  "s": 57.621,
  "e": 59.431,
  "line": "Then his copy said, nice backflip."
 },
 {
  "i": 46,
  "s": 59.431,
  "e": 60.368,
  "line": "I stared at him."
 },
 {
  "i": 47,
  "s": 60.368,
  "e": 62.064,
  "line": "Best picture I ever took."
 }
]