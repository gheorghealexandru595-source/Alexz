[
 {
  "i": 0,
  "s": 0,
  "e": 0.65,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 0.65,
  "e": 1.99,
  "line": "every thank-you you say"
 },
 {
  "i": 2,
  "s": 1.99,
  "e": 2.78,
  "line": "makes you glow."
 },
 {
  "i": 3,
  "s": 2.78,
  "e": 4.51,
  "line": "That's why polite people light up the street,"
 },
 {
  "i": 4,
  "s": 4.51,
  "e": 5.31,
  "line": "and rude people"
 },
 {
  "i": 5,
  "s": 5.31,
  "e": 6.4,
  "line": "walk around in the dark."
 },
 {
  "i": 6,
  "s": 6.4,
  "e": 7.73,
  "line": "I had a nice warm glow."
 },
 {
  "i": 7,
  "s": 7.73,
  "e": 8.88,
  "line": "But my best friend Eli"
 },
 {
  "i": 8,
  "s": 8.88,
  "e": 10.84,
  "line": "was so dark people bumped into him."
 },
 {
  "i": 9,
  "s": 10.84,
  "e": 13.14,
  "line": "He hadn't shown up in a class photo in two years."
 },
 {
  "i": 10,
  "s": 13.14,
  "e": 15.04,
  "line": "Meanwhile, Rosa thanked everything."
 },
 {
  "i": 11,
  "s": 15.04,
  "e": 16.28,
  "line": "The bus driver? Thanks!"
 },
 {
  "i": 12,
  "s": 16.28,
  "e": 17.62,
  "line": "Her sandwich? Thanks!"
 },
 {
  "i": 13,
  "s": 17.62,
  "e": 18.79,
  "line": "A pigeon? Thanks!"
 },
 {
  "i": 14,
  "s": 18.79,
  "e": 20.12,
  "line": "Then my grandma knit me a sweater,"
 },
 {
  "i": 15,
  "s": 20.12,
  "e": 21.45,
  "line": "and I just said, it's itchy."
 },
 {
  "i": 16,
  "s": 21.45,
  "e": 22.16,
  "line": "I went dim."
 },
 {
  "i": 17,
  "s": 22.16,
  "e": 23.48,
  "line": "Grandma squinted to find me."
 },
 {
  "i": 18,
  "s": 23.48,
  "e": 24.71,
  "line": "And that's when I had an idea."
 },
 {
  "i": 19,
  "s": 24.71,
  "e": 25.64,
  "line": "If I thanked everyone,"
 },
 {
  "i": 20,
  "s": 25.64,
  "e": 26.8,
  "line": "I'd glow like Rosa."
 },
 {
  "i": 21,
  "s": 26.8,
  "e": 28.18,
  "line": "I thanked a wall. Nothing."
 },
 {
  "i": 22,
  "s": 28.18,
  "e": 29.61,
  "line": "I yelled thank you really loud."
 },
 {
  "i": 23,
  "s": 29.61,
  "e": 30.27,
  "line": "Still nothing."
 },
 {
  "i": 24,
  "s": 30.27,
  "e": 31.99,
  "line": "Then the janitor fixed my locker,"
 },
 {
  "i": 25,
  "s": 31.99,
  "e": 33.56,
  "line": "and I really meant it. Thank you."
 },
 {
  "i": 26,
  "s": 33.56,
  "e": 34.41,
  "line": "I lit right up."
 },
 {
  "i": 27,
  "s": 34.41,
  "e": 35.48,
  "line": "So I thanked everyone."
 },
 {
  "i": 28,
  "s": 35.48,
  "e": 36.2,
  "line": "The lunch lady."
 },
 {
  "i": 29,
  "s": 36.2,
  "e": 37.22,
  "line": "The crossing guard."
 },
 {
  "i": 30,
  "s": 37.22,
  "e": 38.17,
  "line": "My little sister."
 },
 {
  "i": 31,
  "s": 38.17,
  "e": 40.14,
  "line": "By lunch, I was glowing like Rosa."
 },
 {
  "i": 32,
  "s": 40.14,
  "e": 41.5,
  "line": "But then I bumped into Eli,"
 },
 {
  "i": 33,
  "s": 41.5,
  "e": 42.96,
  "line": "sitting in the dark, alone."
 },
 {
  "i": 34,
  "s": 42.96,
  "e": 44.31,
  "line": "I'd spent all day glowing"
 },
 {
  "i": 35,
  "s": 44.31,
  "e": 46.08,
  "line": "while my best friend was fading out."
 },
 {
  "i": 36,
  "s": 46.08,
  "e": 47.68,
  "line": "So I gave him half my sandwich."
 },
 {
  "i": 37,
  "s": 47.68,
  "e": 48.55,
  "line": "He asked, why?"
 },
 {
  "i": 38,
  "s": 48.55,
  "e": 49.78,
  "line": "Because you're my best friend."
 },
 {
  "i": 39,
  "s": 49.78,
  "e": 50.98,
  "line": "He smiled. Thank you."
 },
 {
  "i": 40,
  "s": 50.98,
  "e": 52.42,
  "line": "No, really. Thank you."
 },
 {
  "i": 41,
  "s": 52.42,
  "e": 55.64,
  "line": "For the first time in two years, Eli showed up in the class photo."
 },
 {
  "i": 42,
  "s": 55.64,
  "e": 57.67,
  "line": "Then he said, the sandwich was gross though."
 },
 {
  "i": 43,
  "s": 57.67,
  "e": 58.46,
  "line": "I stared at him."
 },
 {
  "i": 44,
  "s": 58.46,
  "e": 60.122,
  "line": "Then I said, thanks for eating it."
 }
]