  "line": "I'd have a tiny head like Ivy."
 },
 {
  "i": 21,
  "s": 25.66,
  "e": 27.11,
  "line": "I counted to ten. Nothing."
 },
 {
  "i": 22,
  "s": 27.11,
  "e": 28.03,
  "line": "I tried yoga."
 },
 {
  "i": 23,
  "s": 28.03,
  "e": 28.83,
  "line": "Still nothing."
 },
 {
  "i": 24,
  "s": 28.83,
  "e": 30.14,
  "line": "Then a kid spilled milk on me,"
 },
 {
  "i": 25,
  "s": 30.14,
  "e": 31.07,
  "line": "and I just laughed."
 },
 {
  "i": 26,
  "s": 31.07,
  "e": 32.44,
  "line": "My head shrank right back."
 },
 {
  "i": 27,
  "s": 32.44,
  "e": 33.66,
  "line": "So I let everything go."
 },
 {
  "i": 28,
  "s": 33.66,
  "e": 35.1,
  "line": "Someone cut in line? Fine."
 },
 {
  "i": 29,
  "s": 35.1,
  "e": 36.21,
  "line": "Bad grade? Fine."
 },
 {
  "i": 30,
  "s": 36.21,
  "e": 37.99,
  "line": "By the end of the day, my head was tiny."
 },
 {
  "i": 31,
  "s": 37.99,
  "e": 39.13,
  "line": "But then I saw Max,"
 },
 {
  "i": 32,
  "s": 39.13,
  "e": 40.49,
  "line": "stuck in a door, alone."
 },
 {
  "i": 33,
  "s": 40.49,
  "e": 41.89,
  "line": "I'd spent all day staying calm"
