[
 {
  "i": 0,
  "s": 0,
  "e": 1.03,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 1.03,
  "e": 1.92,
  "line": "every time you get angry,"
 },
 {
  "i": 2,
