  "line": "had the biggest head in school."
 },
 {
  "i": 10,
  "s": 10.41,
  "e": 11.92,
  "line": "He hadn't worn a hat in three years."
 },
 {
  "i": 11,
  "s": 11.92,
  "e": 13.45,
  "line": "Meanwhile, Ivy never got mad."
 },
 {
  "i": 12,
  "s": 13.45,
  "e": 14.82,
  "line": "Stepped on her foot? Smile."
 },
 {
  "i": 13,
  "s": 14.82,
  "e": 16.3,
  "line": "Juice on her sweater? Smile."
 },
 {
  "i": 14,
  "s": 16.3,
  "e": 17.96,
  "line": "Took her seat? Still smiling."
 },
 {
  "i": 15,
  "s": 17.96,
  "e": 19.37,
  "line": "Then someone ate my pudding."
 },
 {
  "i": 16,
  "s": 19.37,
  "e": 20.81,
  "line": "My head blew up like a balloon."
 },
 {
  "i": 17,
  "s": 20.81,
  "e": 21.7,
  "line": "Ivy gasped."
 },
 {
  "i": 18,
  "s": 21.7,
  "e": 23.03,
  "line": "And that's when I had an idea."
 },
 {
  "i": 19,
  "s": 23.03,
  "e": 24.21,
  "line": "If I stayed calm all day,"
 },
 {
  "i": 20,
  "s": 24.21,
