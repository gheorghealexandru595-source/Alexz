  "line": "can't fit through doors,"
 },
 {
  "i": 5,
  "s": 4.88,
  "e": 5.53,
  "line": "and calm people"
 },
 {
  "i": 6,
  "s": 5.53,
  "e": 6.62,
  "line": "have heads like grapes."
 },
 {
  "i": 7,
  "s": 6.62,
  "e": 7.91,
  "line": "My head was pretty normal."
 },
 {
  "i": 8,
  "s": 7.91,
  "e": 9.06,
  "line": "But my best friend Max"
 },
 {
  "i": 9,
  "s": 9.06,
